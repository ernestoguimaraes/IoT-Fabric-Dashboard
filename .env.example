# ─── Front-end (Vite) ────────────────────────────────────────────────────────
# mock   → simulador local no navegador (padrão, não precisa do servidor)
# fabric → telemetria via proxy (/api) lida do Eventhouse do Fabric RTI
VITE_TELEMETRY_MODE=mock
# mock    → assistente local com contexto e sugestões da planta
# foundry → conversa direta: somente texto digitado, sem contexto ou fallback local
VITE_AGENT_MODE=mock

# ─── Proxy (server/index.js) ─────────────────────────────────────────────────
API_PORT=8787

# Fabric Real-Time Intelligence
# Eventstream → fonte "Custom endpoint" (protocolo Event Hubs, chave SAS)
FABRIC_EVENTSTREAM_CONNECTION_STRING=
FABRIC_EVENTSTREAM_NAME=
# Eventhouse (KQL) — Query URI e banco
FABRIC_KUSTO_URI=https://<seu-eventhouse>.kusto.fabric.microsoft.com
FABRIC_KUSTO_DATABASE=IoTFactory
FABRIC_KUSTO_SCOPE=https://kusto.kusto.windows.net/.default
FABRIC_TELEMETRY_TABLE=MachineTelemetry
FABRIC_PARAMS_TABLE=MachineParams
FABRIC_POLL_MS=3000
# Sem Fabric? true = o proxy emula Eventstream+Eventhouse em memória (testa o caminho fabric ponta a ponta)
FABRIC_LOOPBACK=false
# Simulador de dispositivos (npm run simulate:devices)
DEVICE_INTERVAL_MS=2000

# Microsoft Foundry Agent Service (autenticação via DefaultAzureCredential / az login)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<projeto>
FOUNDRY_AGENT_NAME=
# Compatibilidade opcional com o Agent Service clássico (ID asst_...):
# FOUNDRY_AGENT_ID=
FOUNDRY_API_VERSION=v1
FOUNDRY_SCOPE=https://ai.azure.com/.default
# true = registra mensagens, payload exato enviado e resposta no console do proxy
FOUNDRY_DEBUG=false
