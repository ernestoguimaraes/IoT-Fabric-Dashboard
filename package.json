{
  "name": "grupo-gps-iot-dash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SPA de monitoramento IoT (cena 3D v2) com ajuste de parâmetros, integração Fabric Real-Time Intelligence e assistente Foundry.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:server\"",
    "simulate:devices": "node --env-file-if-exists=.env server/deviceSimulator.js"
  },
  "dependencies": {
    "@azure/event-hubs": "^6.0.0",
    "@azure/identity": "^4.10.0",
    "express": "^5.1.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
